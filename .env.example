# Copy to ignored .env.local, keep mode 0600, and never commit real values.
INF_ALLOWED_GITHUB_USER=aserdargun
# Azure runtime-required IDs
INF_PRIVATE_DRIVE_FOLDER_ID=
INF_EVENTS_FOLDER_ID=
INF_LIBRARY_FOLDER_ID=
INF_THUMBNAILS_FOLDER_ID=
INF_DUPLICATES_FOLDER_ID=
# Provisioning/audit-only IDs (not Azure application settings)
INF_ARCHIVE_FOLDER_ID=
INF_REVIEWS_FOLDER_ID=
INF_QUARANTINE_FOLDER_ID=
INF_EXPORTS_FOLDER_ID=
INF_DRIVE_TEST_ROOT_ID=
# Desktop OAuth credentials; uploads now land directly in the Library folder
# via the capture flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
