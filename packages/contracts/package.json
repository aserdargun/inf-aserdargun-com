{
  "name": "@inf/contracts",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./dist/index.js" },
    "./public": { "types": "./src/public.ts", "default": "./dist/public.js" }
  },
  "scripts": {
    "build": "node ../../scripts/clean-output.mjs dist && tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
