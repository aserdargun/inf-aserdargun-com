{
  "name": "@inf/domain",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": { ".": { "types": "./src/index.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "node ../../scripts/clean-output.mjs dist && tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "test": "vitest run",
    "vitest": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@inf/contracts": "workspace:0.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
