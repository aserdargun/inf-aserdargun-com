{
  "routes": [
    {
      "route": "/view/*",
      "rewrite": "/view/index.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/view*",
      "rewrite": "/view/index.html",
      "allowedRoles": ["anonymous"]
    },
    { "route": "/api/public/*", "allowedRoles": ["anonymous"] },
    { "route": "/login", "allowedRoles": ["anonymous"] },
    { "route": "/_next/*", "allowedRoles": ["anonymous"] },
    { "route": "/manifest.webmanifest", "allowedRoles": ["anonymous"] },
    { "route": "/sw.js", "allowedRoles": ["anonymous"] },
    { "route": "/favicon.ico", "allowedRoles": ["anonymous"] },
    { "route": "/.auth/login/aad", "statusCode": 404 },
    {
      "route": "/infographic/*",
      "rewrite": "/infographic/index.html",
      "allowedRoles": ["authenticated"]
    },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "platform": {
    "apiRuntime": "node:22"
  },
  "responseOverrides": {
    "401": {
      "redirect": "/login"
    }
  }
}
